{
  "name": "equiroute",
  "version": "1.1.1",
  "private": true,
  "description": "Pre-trade execution firewall for tokenized stocks on BNB Smart Chain.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/binanceClient.test.ts src/services/executionGuard.test.ts src/services/bscRpcService.test.ts src/services/rwaService.test.ts",
    "agent:check": "node skills/equiroute-guard/scripts/cli.mjs analyze",
    "agent:quote": "node skills/equiroute-guard/scripts/cli.mjs agentic-quote",
    "dx:benchmark": "node scripts/dx-benchmark.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
